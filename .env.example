# Copy this file to .env in the project root. Never commit .env.

# Application security
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Plaid credentials from https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret

# sandbox | development | production
PLAID_ENV=sandbox

# Optional for basic local Sandbox testing. Automatic webhooks require a
# public HTTPS URL that forwards to POST /plaid/webhook.
PLAID_WEBHOOK_URL=

# MongoDB Atlas. Percent-encode special characters in the URI password.
# Keep the complete connection string in the backend environment only.
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=finance_builder
