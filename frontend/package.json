{
  "name": "personal-finance-manager-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "dev:sandbox": "vite --mode plaid-sandbox",
    "build:sandbox": "tsc -b && vite build --mode plaid-sandbox",
    "build": "tsc -b && vite build",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "android:add": "cap add android",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview",
    "test:split-bill": "node --test tests/splitBill.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.544.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "typescript-eslint": "^8.72.0"
  }
}
