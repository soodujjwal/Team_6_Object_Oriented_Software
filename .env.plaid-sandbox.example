# Copy to .env.plaid-sandbox in the project root; keep actual keys out of Git.
# Use your Atlas URI with a DIFFERENT database for this demo profile.
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=finance_builder_plaid_sandbox
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
