# Copy this file to .env in the project root. Never commit .env.

# Application security
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Plaid credentials from https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret

# sandbox | development | production
PLAID_ENV=sandbox

# Optional for basic local Sandbox testing. Automatic webhooks require a
# public HTTPS URL that forwards to POST /plaid/webhook.
PLAID_WEBHOOK_URL=

# Optional database override. Leave blank to use backend/finance_manager.db.
# DATABASE_URL=sqlite:///./finance_manager.db
